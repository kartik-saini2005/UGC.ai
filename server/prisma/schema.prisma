generator client {
  provider = "prisma-client"
  output = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String     @id
  email     String     
  name      String     
  image     String     
  credits   Int      @default(20)     
  creditsAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //Relations
  projects       Project[]
}

model Project{
  id                 String     @id @default(uuid())
  name               String    
  userId             String
   generatedVideo    String?
  productName        String   @default("")
  productDescription String   @default("")
  userPrompt         String   @default("9:16")
  targetLength       Int      @default(5)
  uploadedImages     String[]
  generatedImage     String   @default("")
  uploadedVideo      String   @default("")
  isGenerating       Boolean   @default("false")
  isPublished        String   @default("false")
  error              String   @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  //Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}